<component type="desktop-application">
  <id>com.promptpetal.PromptPetal</id>
  <name>Prompt Petal</name>
  <summary>Your most used AI instructions, one click away</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <developer id="com.promptpetal">
